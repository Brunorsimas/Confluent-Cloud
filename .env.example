# Copie para .env. Os scripts carregam este arquivo sem executar seu conteudo.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=
# Postgres acessivel ao conector gerenciado; nunca localhost para o Cloud.
PGHOST=
PGPORT=5432
PGDATABASE=payments
PGUSER=
PGPASSWORD=
PGSSLMODE=require
# Usuario de replicacao criado por pg-init; separado do administrador acima.
CDC_USER=payments_cdc
CDC_PASSWORD=
# Opcional: caminho do executavel quando nao estiver no PATH.
TERRAFORM=terraform
# Apenas para o Postgres local opcional do Docker Compose.
POSTGRES_PASSWORD=
